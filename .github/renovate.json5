{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":dependencyDashboard"],
  timezone: "Asia/Tokyo",
  schedule: ["before 9am on monday"], // 週次でまとめて
  labels: ["dependencies"],
  packageRules: [
    {
      // GitHub Actions（ワークフロー）を 1 グループに
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
    {
      // crates.io の minor/patch はまとめる（major は個別 PR のまま）
      matchManagers: ["cargo"],
      matchUpdateTypes: ["minor", "patch"],
      matchCurrentVersion: ">=1.0.0",
      groupName: "cargo minor/patch",
    },
    {
      // 0.x の minor は Cargo の semver では破壊的（`^0.9` は 0.12 を含まない）が、
      // Renovate の update type としては "minor" になる。グループ化のルール自体を
      // バージョンで区切り、0.x の minor だけをグループから外して個別 PR にする。
      matchManagers: ["cargo"],
      matchUpdateTypes: ["patch"],
      matchCurrentVersion: "<1.0.0",
      groupName: "cargo minor/patch",
    },
    {
      // gpui スタックは lockstep でしか上げられない。gpui-component は特定の
      // gpui-pre に依存しており、片方だけ上がると API が合わずコンパイルできない。
      // 1 PR にまとめる。後方のルールが優先されるので minor/patch グループより後。
      matchManagers: ["cargo"],
      matchPackageNames: ["gpui-pre", "/^gpui-pre-/", "gpui-component"],
      groupName: "gpui stack",
    },
  ],
  lockFileMaintenance: {
    // `cargo update` を回して semver 範囲内の推移的依存を Cargo.lock ごと更新する。
    // git 依存が無くなったので、これは純粋に lock の鮮度維持。
    enabled: true,
    schedule: ["before 9am on the first day of the month"],
  },
}
